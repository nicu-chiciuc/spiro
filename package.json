{
  "name": "spiro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "vp check && vp run typecheck && vp test",
    "build": "vp run build:cloudflare",
    "build:app": "vp run check && vp build && vp run verify:artifact",
    "build:cloudflare": "vp run build:app",
    "deploy": "node ./scripts/deploy-cloudflare.ts deploy",
    "deploy:preview": "node ./scripts/deploy-cloudflare.ts preview",
    "deploy:dry-run": "node ./scripts/deploy-cloudflare.ts deploy --dry-run",
    "deploy:preview:dry-run": "node ./scripts/deploy-cloudflare.ts preview --dry-run",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --report-unused-disable-directives",
    "prepare": "vp config",
    "test": "vp test",
    "typecheck": "tsc --project tsconfig.node.json",
    "verify:artifact": "node ./scripts/verify-provider-artifact.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.118.0"
  },
  "packageManager": "pnpm@11.1.1"
}
